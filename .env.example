# Copy this file to .env and fill in what you need. Nothing here is required —
# CyberSentinel runs fully offline with sane defaults if you skip this entirely.

# --- LLM (Ollama — local model, no API key needed) ---
# CyberSentinel uses the local Ollama instance for natural-language understanding.
# Make sure Ollama is running (`ollama serve`) and the model is pulled
# (`ollama pull qwen2.5:3b`). The assistant works fully offline this way.
CS_OLLAMA_BASE_URL=http://localhost:11434/v1/chat/completions
CS_LLM_MODEL=qwen2.5:3b
CS_LLM_ENABLED=true
CS_OLLAMA_EMBED_MODEL=nomic-embed-text
# Pull separately with `ollama pull nomic-embed-text` to enable semantic retrieval.
# If unavailable, action retrieval uses a local lexical/similarity fallback.

# Optional cloud retry. Disabled by default; requires an HTTPS OpenAI-compatible
# endpoint and sends only a sanitized request after low local-model confidence.
CS_CLOUD_LLM_ENABLED=false
CS_CLOUD_LLM_BASE_URL=
CS_CLOUD_LLM_MODEL=
CS_CLOUD_LLM_API_KEY=

# --- Database ---
CS_DB_PATH=./data/cybersentinel.db

# --- Feature toggles ---
CS_ENABLE_SNIFFER=false
CS_ENABLE_FS_WATCH=true
CS_ENABLE_NOTIFY=true
CS_FS_WATCH_PATHS=C:\Users\YourName\Downloads,C:\Users\YourName\Desktop

# --- Monitor intervals (seconds) ---
CS_INTERVAL_PROCESSES=30
CS_INTERVAL_PORTS=30
CS_INTERVAL_LOGINS=60
CS_INTERVAL_BROWSER=120
CS_INTERVAL_STARTUP=300
CS_INTERVAL_SERVICES=300
CS_INTERVAL_SOFTWARE=600
CS_INTERVAL_SCHEDULED_TASKS=600
CS_INTERVAL_HEALTH=15

# --- Alert thresholds ---
CS_CPU_SPIKE_PCT=50
CS_CPU_BASELINE_MULT=4
CS_FAILED_LOGIN_COUNT=3
CS_FAILED_LOGIN_WINDOW_MIN=15
CS_PORT_SCAN_COUNT=5
CS_PORT_SCAN_WINDOW_SEC=3

# A repeated alert (same category+condition) within this window gets folded
# into the existing alert's occurrence count instead of creating a new row —
# prevents a single sustained issue (e.g. one ongoing CPU spike) from
# flooding the alerts table and inflating the threat level.
CS_ALERT_DEDUP_WINDOW_MIN=15

# --- API server (for the web UI) ---
CS_API_HOST=127.0.0.1
CS_API_PORT=5055

# --- Logging ---
CS_LOG_LEVEL=INFO
